# Backend Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Configuration
STORAGE_MODE=local
# Optional MongoDB connection (Application works completely without MongoDB)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=footer_studio

# AI Configuration (Optional - Defaults to deterministic rule-based engine)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
AI_FALLBACK_MODE=rule_based

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:8000
